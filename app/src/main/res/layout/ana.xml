<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zemin"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingLeft="12dp"
    android:paddingTop="8dp"
    android:paddingRight="12dp"
    android:paddingBottom="8dp">

    <!-- Dil başlıkları -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/karsi_dil"
            android:textColor="@color/soluk"
            android:textSize="12sp" />

        <View
            android:layout_width="56dp"
            android:layout_height="1dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ben_dil"
            android:textColor="@color/soluk"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Dil seçimi -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Spinner
            android:id="@+id/karsiDil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/kart"
            android:popupBackground="@drawable/kart" />

        <Button
            android:id="@+id/degistir"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:background="@drawable/dugme_ikincil"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="⇄"
            android:textColor="@color/yazi"
            android:textSize="20sp" />

        <Spinner
            android:id="@+id/benDil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/kart"
            android:popupBackground="@drawable/kart" />
    </LinearLayout>

    <TextView
        android:id="@+id/durum"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/soluk"
        android:textSize="13sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1">

        <!-- KONUŞMA -->
        <LinearLayout
            android:id="@+id/sayfaKonusma"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <ScrollView
                android:id="@+id/akisKaydir"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/akis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/bosSohbet"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/kart"
                        android:lineSpacingExtra="4dp"
                        android:padding="16dp"
                        android:text="@string/bos_sohbet"
                        android:textColor="@color/soluk"
                        android:textSize="15sp" />
                </LinearLayout>
            </ScrollView>

            <TextView
                android:id="@+id/canli"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/kart"
                android:lineSpacingExtra="3dp"
                android:maxLines="6"
                android:minHeight="56dp"
                android:padding="12dp"
                android:textColor="@color/yazi"
                android:textSize="17sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/sesli"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sesli_oku"
                    android:textColor="@color/yazi"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/ayrim"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:text="@string/kulaklik_modu"
                    android:textColor="@color/yazi"
                    android:textSize="14sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/sil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="@string/sohbeti_sil"
                    android:textColor="@color/soluk"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/dinle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/dugme"
                    android:stateListAnimator="@null"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/cevap"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/dugme_ikincil"
                    android:stateListAnimator="@null"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- YAZI -->
        <LinearLayout
            android:id="@+id/sayfaYazi"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/yon"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/dugme_ikincil"
                android:stateListAnimator="@null"
                android:textAllCaps="false"
                android:textColor="@color/yazi"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/giris"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:background="@drawable/kart"
                android:gravity="top|left"
                android:hint="@string/yazi_ipucu"
                android:inputType="textMultiLine|textCapSentences"
                android:padding="14dp"
                android:textColor="@color/yazi"
                android:textColorHint="@color/soluk"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/yapistir"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/sekme"
                    android:stateListAnimator="@null"
                    android:text="@string/yapistir"
                    android:textAllCaps="false"
                    android:textColor="@color/yazi"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/temizle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/sekme"
                    android:stateListAnimator="@null"
                    android:text="@string/temizle"
                    android:textAllCaps="false"
                    android:textColor="@color/yazi"
                    android:textSize="14sp" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:background="@drawable/kart"
                android:fillViewport="true">

                <TextView
                    android:id="@+id/cikti"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:padding="14dp"
                    android:textColor="@color/yazi"
                    android:textIsSelectable="true"
                    android:textSize="20sp" />
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/oku"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/dugme"
                    android:stateListAnimator="@null"
                    android:text="@string/oku"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/kopyala"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/dugme_ikincil"
                    android:stateListAnimator="@null"
                    android:text="@string/kopyala"
                    android:textAllCaps="false"
                    android:textColor="@color/yazi"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- KAMERA -->
        <LinearLayout
            android:id="@+id/sayfaKamera"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.camera.view.PreviewView
                    android:id="@+id/onizleme"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <ImageView
                    android:id="@+id/donuk"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:visibility="gone" />

                <app.tercuman.KameraKatmani
                    android:id="@+id/katman"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/kameraNot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#B00F1418"
                    android:padding="10dp"
                    android:textColor="@color/yazi"
                    android:textSize="14sp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/fener"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/dugme_ikincil"
                    android:stateListAnimator="@null"
                    android:text="@string/fener"
                    android:textAllCaps="false"
                    android:textColor="@color/yazi"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/cek"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:layout_weight="2"
                    android:background="@drawable/dugme"
                    android:stateListAnimator="@null"
                    android:text="@string/cevir"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/kameraOku"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/dugme_ikincil"
                    android:stateListAnimator="@null"
                    android:text="@string/oku"
                    android:textAllCaps="false"
                    android:textColor="@color/yazi"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Sekmeler -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/sekmeKonusma"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginRight="4dp"
            android:layout_weight="1"
            android:background="@drawable/sekme_secili"
            android:stateListAnimator="@null"
            android:text="@string/sekme_konusma"
            android:textAllCaps="false"
            android:textColor="@color/yazi"
            android:textSize="15sp" />

        <Button
            android:id="@+id/sekmeYazi"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:layout_weight="1"
            android:background="@drawable/sekme"
            android:stateListAnimator="@null"
            android:text="@string/sekme_yazi"
            android:textAllCaps="false"
            android:textColor="@color/yazi"
            android:textSize="15sp" />

        <Button
            android:id="@+id/sekmeKamera"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="4dp"
            android:layout_weight="1"
            android:background="@drawable/sekme"
            android:stateListAnimator="@null"
            android:text="@string/sekme_kamera"
            android:textAllCaps="false"
            android:textColor="@color/yazi"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
