<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zemin"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/app_name"
            android:textColor="@color/yazi"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/alt"
            android:textColor="@color/soluk"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/durum"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/kart"
            android:lineSpacingExtra="3dp"
            android:padding="16dp"
            android:text="@string/durum_hazir"
            android:textColor="@color/yazi"
            android:textSize="16sp" />

        <Button
            android:id="@+id/izin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/dugme_ikincil"
            android:minHeight="54dp"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:stateListAnimator="@null"
            android:text="@string/izin_ver"
            android:textAllCaps="false"
            android:textColor="@color/yazi"
            android:textSize="15sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/dil_baslik"
            android:textColor="@color/soluk"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/dil"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/kart"
            android:popupBackground="@drawable/kart" />

        <Button
            android:id="@+id/baslat"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/dugme"
            android:stateListAnimator="@null"
            android:text="@string/baslat"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/nasil_baslik"
            android:textColor="@color/yazi"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="5dp"
            android:text="@string/nasil"
            android:textColor="@color/soluk"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/not_baslik"
            android:textColor="@color/yazi"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:lineSpacingExtra="5dp"
            android:text="@string/notlar"
            android:textColor="@color/soluk"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
